{
  "name": "speak-with-rhythm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host localhost --port 5173 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/server/tests/*.test.js",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.test.json --noEmit --pretty"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.29.0",
    "multer": "^2.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^10.0.4",
    "supertest": "^7.2.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.10",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
